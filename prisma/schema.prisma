generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model FavoriteStock {
  id        String   @id @default(uuid())
  userId    String
  stockId   String
  createdAt DateTime @default(now())
  stock     Stock    @relation(fields: [stockId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, stockId])
}

model Transaction {
  id         String          @id @default(uuid())
  userId     String
  stockId    String
  type       TransactionType
  quantity   Int
  price      Decimal         @db.Decimal(15, 4)
  totalPrice Decimal         @db.Decimal(15, 2)
  createdAt  DateTime        @default(now())

  user  User  @relation(fields: [userId], references: [id])
  stock Stock @relation(fields: [stockId], references: [id])

  @@index([userId])
  @@index([stockId])
  @@index([userId, createdAt])
}

enum TransactionType {
  BUY
  SELL
}

model Holdingstock {
  id       String  @id @default(uuid())
  userId   String
  quantity Int
  avgPrice Decimal @db.Decimal(15, 2)
  user     User    @relation(fields: [userId], references: [id])
  stock    Stock   @relation(fields: [stockId], references: [id])
  stockId  String

  @@unique([userId, stockId])
  @@index([userId], map: "Holdingstock_userId_fkey")
}

model Orderhistory {
  id         String              @id @default(uuid())
  orderNo    Int                 @unique(map: "Order_orderNo_key")
  userId     String
  method     orderhistory_method
  status     orderhistory_status
  quantity   Int
  priceStock Decimal             @db.Decimal(15, 2)
  createdAt  DateTime            @default(now()) @db.Timestamp(0)
  stockId    String

  user  User  @relation(fields: [userId], references: [id])
  stock Stock @relation(fields: [stockId], references: [id])

  @@index([stockId], map: "Order_stockId_fkey")
  @@index([userId], map: "Order_userId_fkey")
}

model Stock {
  id             String          @id @default(uuid())
  symbol         String          @unique(map: "Stock_stockName_key")
  companyName    String
  exchange       String
  currency       String?
  logo           String?
  industry       String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now())
  candles        Stockcandle[]
  orderhistories Orderhistory[]
  holdings       Holdingstock[]
  transactions   Transaction[]
  favoriteStock  FavoriteStock[]
}

model Stockcandle {
  id        String   @id @default(uuid())
  symbol    String
  open      Decimal  @db.Decimal(15, 2)
  high      Decimal  @db.Decimal(15, 2)
  low       Decimal  @db.Decimal(15, 2)
  close     Decimal  @db.Decimal(15, 2)
  volume    Int?
  timestamp DateTime
  createdAt DateTime @default(now())
  stock     Stock    @relation(fields: [symbol], references: [symbol])

  @@unique([symbol, timestamp])
  @@index([symbol, timestamp])
}

model User {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String   @unique(map: "User_email_key")
  mobile    String   @unique(map: "User_mobile_key")
  password  String
  createdAt DateTime @default(now()) @db.Timestamp(0)

  wallet         Wallet?
  portfolio      Holdingstock[]
  orders         Orderhistory[]
  transactions   Transaction[]
  favoriteStocks FavoriteStock[]
}

model Wallet {
  id      String          @id @default(uuid())
  userId  String          @unique(map: "Wallet_userId_key")
  balance Decimal         @default(0.00) @db.Decimal(15, 2)
  user    User            @relation(fields: [userId], references: [id])
  history Wallethistory[]
}

model Wallethistory {
  id         String                 @id @default(uuid())
  walletId   String
  amount     Decimal                @db.Decimal(15, 2)
  bookbankId String
  bankName   wallethistory_bankName
  createdAt  DateTime               @default(now()) @db.Timestamp(0)

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId], map: "WalletHistory_walletId_fkey")
}

enum tradehistory_method {
  DEPOSITION
  WITHDRAW
}

enum orderhistory_method {
  BUY
  SELL
}

enum orderhistory_status {
  PENDING
  MATCHED
  CANCELLED
  REJECTED
}

enum wallethistory_bankName {
  SCB
  KBANK
  KTB
  BBL
  TTB
}
