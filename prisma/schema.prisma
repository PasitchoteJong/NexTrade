// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String         @id @default(uuid())
  firstName     String
  lastName      String
  email         String         @unique(map: "User_email_key")
  mobile        String         @unique(map: "User_mobile_key")
  password      String
  createdAt     DateTime       @default(now()) @db.Timestamp(0)
  order         OrderHistory[]
  transactions  TradeHistory[]
  currentStocks CurrentStock[]
  wallet        Wallet?
}

model Wallet {
  id      String  @id @default(uuid())
  userId  String  @unique
  balance Decimal @default(0) @db.Decimal(15, 2)
  user    User    @relation(fields: [userId], references: [id])

  walletHistories WalletHistory[]
}

model WalletHistory {
  id         String         @id @default(uuid())
  walletId   String
  amount     Decimal        @db.Decimal(15, 2)
  bookbankId String
  bankName   BankNameStatus
  createdAt  DateTime       @default(now()) @db.Timestamp(0)

  wallet Wallet @relation(fields: [walletId], references: [id])
}

model TradeHistory {
  id        String            @id @default(uuid())
  method    TransactionStatus
  amount    Int
  createdAt DateTime          @default(now()) @db.Timestamp(0)
  userId    String
  id_user   User              @relation(fields: [userId], references: [id])

  @@index([userId], map: "transaction_userId_fkey")
}

model CurrentStock {
  id           String @id @default(uuid())
  userId       String
  stockName    String
  currentStock Int
  avgPrice     Int
  user         User   @relation(fields: [userId], references: [id])
}

model OrderHistory {
  id          String       @id @default(uuid())
  orderNo     Int          @unique(map: "Order_orderNo_key")
  userId      String
  method      Order_method
  status      Status_order
  amountStock Int
  priceStock  Int
  createdAt   DateTime     @default(now()) @db.Timestamp(0)
  stockId     String
  stock       Stock        @relation(fields: [stockId], references: [id], map: "Order_stockId_fkey")
  user        User         @relation(fields: [userId], references: [id], map: "Order_userId_fkey")

  @@index([stockId], map: "Order_stockId_fkey")
  @@index([userId], map: "Order_userId_fkey")
}

model Stock {
  id             String         @id @default(uuid())
  symbol         String         @unique(map: "Stock_stockName_key")
  companyName    String
  exchange       String
  currency       String?
  logo           String?
  industry       String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  orderHistories OrderHistory[]
}

enum TransactionStatus {
  DEPOSITION
  WITHDRAW
}

enum BankNameStatus {
  SCB
  KBANK
  KTB
  BBL
  TTB
}

enum Order_method {
  BUY
  SELL
}

enum Status_order {
  PENDING
  MATCHED
  CANCELLED
  REJECTED
}
